[Plymouth Theme]
Name=Nova
Description=Nova OS — un arc fin qui tourne autour du logo
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/nova
HorizontalAlignment=.5
VerticalAlignment=.5
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.72
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.30
MessageBelowAnimation=true
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0b0d12
BackgroundEndColor=0x0b0d12
ProgressBarBackgroundColor=0x1a1e26
ProgressBarForegroundColor=0x8ab4ff

[boot-up]
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
UseProgressBar=true
ProgressBarShowPercentComplete=true
Title=Installation des mises à jour…
SubTitle=N'éteins pas l'ordinateur

[system-upgrade]
SuppressMessages=true
UseProgressBar=true
ProgressBarShowPercentComplete=true
Title=Mise à niveau du système…
SubTitle=N'éteins pas l'ordinateur
