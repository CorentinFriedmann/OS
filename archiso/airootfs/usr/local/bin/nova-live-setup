#!/usr/bin/env bash
# Session live : crée l'utilisateur « nova » (sans mot de passe) et ajoute le
# message d'accueil « Installer Nova OS » au démarrage du bureau.
set -euo pipefail
groups=wheel,video,input,audio
getent group vboxsf >/dev/null && groups+=,vboxsf   # VirtualBox : dossiers partagés (/media/sf_*)
useradd -m -u 1000 -G "$groups" -s /usr/bin/fish -c "Nova (session d'essai)" nova
passwd -d nova >/dev/null
config=/home/nova/.config/hypr/hyprland.lua
if [[ -f "$config" ]]; then
  cat >> "$config" <<'LUA'

-- Session d'essai : propose l'installation
hl.on("hyprland.start", function() hl.exec_cmd("nova-live-welcome") end)
LUA
fi
mkdir -p /home/nova/.local/state/nova
touch /home/nova/.local/state/nova/welcome-done   # pas d'accueil de l'assistant en live
chown -R nova:nova /home/nova
