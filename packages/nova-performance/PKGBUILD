# Maintainer: Nova OS <https://github.com/CorentinFriedmann/os>
# Réglages de performance « façon CachyOS » et modes Éco / Équilibré /
# Performance / Jeu, mise à jour en une commande, dépôts optimisés.
pkgname=nova-performance
pkgver=${NOVA_PKGVER:-0.1.0}
pkgrel=1
pkgdesc="Nova OS — réglages de performance, modes d'énergie et outils système"
arch=('any')
url="https://github.com/CorentinFriedmann/os"
license=('MIT')
depends=('bash' 'sudo' 'polkit')
optdepends=("power-profiles-daemon: profils d'énergie"
            "scx-scheds: ordonnanceurs sched-ext (scx_lavd)"
            "zram-generator: swap compressé en mémoire"
            "iw: économie d'énergie du Wi-Fi")

# Copie avec droits explicites (cp + chmod plutôt que « install » : fiable avec
# toutes les versions de fakeroot).
_put() {  # _put DROITS SOURCE DESTINATION
  mkdir -p "$(dirname "$3")"
  cp "$2" "$3"
  chmod "$1" "$3"
}
_put_into() {  # _put_into DROITS DOSSIER FICHIERS...
  local mode=$1 dir=$2 file
  shift 2
  mkdir -p "$dir"
  for file in "$@"; do _put "$mode" "$file" "$dir/$(basename "$file")"; done
}

package() {
  local src="$startdir/../../system"
  _put 644 "$src/sysctl.d/99-nova.conf" "$pkgdir/usr/lib/sysctl.d/99-nova.conf"
  _put 644 "$src/udev/60-nova-ioschedulers.rules" "$pkgdir/usr/lib/udev/rules.d/60-nova-ioschedulers.rules"
  _put 644 "$src/modprobe.d/nova.conf" "$pkgdir/usr/lib/modprobe.d/nova.conf"
  _put 644 "$src/etc/zram-generator.conf" "$pkgdir/usr/lib/systemd/zram-generator.conf"
  local dir
  for dir in journald.conf.d system.conf.d user.conf.d logind.conf.d; do
    _put 644 "$src/systemd/$dir/nova.conf" "$pkgdir/usr/lib/systemd/$dir/nova.conf"
  done
  _put_into 644 "$pkgdir/usr/lib/systemd/system" "$src"/systemd/system/*.service
  _put 440 "$src/sudoers.d/nova" "$pkgdir/etc/sudoers.d/nova"
  _put_into 755 "$pkgdir/usr/bin" "$src"/bin/*
  _put_into 755 "$pkgdir/usr/lib/nova" "$src"/lib/*
  # Droits explicites (indépendants de la version d'install/fakeroot utilisée)
  find "$pkgdir" -type f -exec chmod 644 {} +
  chmod 755 "$pkgdir"/usr/bin/* "$pkgdir"/usr/lib/nova/*
  chmod 440 "$pkgdir/etc/sudoers.d/nova"
}
