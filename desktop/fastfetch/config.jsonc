// NOVA OS — carte d'identité affichée à l'ouverture d'un terminal (fastfetch)
// Pour personnaliser : copie ce fichier dans ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/nova/fastfetch/logo.txt",
    "color": { "1": "38;2;138;180;255", "2": "38;2;164;173;189", "3": "38;2;185;173;255" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;138;180;255", "title": "38;2;185;173;255" },
    "key": { "width": 17 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[38;2;74;83;120m──────────────────────────────" },
    { "type": "os", "key": "󰙴  Système", "format": "{pretty-name} (base Arch, {arch})" },
    { "type": "kernel", "key": "  Noyau" },
    { "type": "uptime", "key": "󰅐  Allumé depuis" },
    { "type": "packages", "key": "󰏗  Paquets" },
    { "type": "wm", "key": "󰍹  Bureau" },
    { "type": "terminal", "key": "  Terminal" },
    { "type": "cpu", "key": "  Processeur" },
    { "type": "gpu", "key": "󰢮  Graphique" },
    { "type": "memory", "key": "󰍛  Mémoire" },
    { "type": "disk", "key": "󰋊  Disque", "folders": "/" },
    { "type": "battery", "key": "󰁹  Batterie" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
