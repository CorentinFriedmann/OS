# ╔══════════════════════════════════════════════════════════════╗
# ║  NOVA OS — terminal Ghostty                                   ║
# ╚══════════════════════════════════════════════════════════════╝
# Tes réglages personnels vont dans ~/.config/ghostty/config.ghostty

font-family = JetBrainsMono Nerd Font
font-size = 12
font-feature = calt
font-feature = liga

# Palette « Verre » de Nova : graphite, couleurs douces, accent bleu glacier
background = #0e1117
foreground = #e2e7ef
cursor-color = #8ab4ff
cursor-text = #0b0d12
selection-background = #2a3346
selection-foreground = #ffffff
palette = 0=#1c212b
palette = 1=#ff8f8f
palette = 2=#7ee2b8
palette = 3=#f2cf86
palette = 4=#8ab4ff
palette = 5=#b9adff
palette = 6=#7fd3d0
palette = 7=#c9d0dc
palette = 8=#4b5263
palette = 9=#ffa8a8
palette = 10=#9eecc9
palette = 11=#f6dba3
palette = 12=#a9c7ff
palette = 13=#cdc4ff
palette = 14=#9fe0dd
palette = 15=#f4f6fa

# Verre fumé : Hyprland floute ce qui est derrière
background-opacity = 0.82
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = none
window-theme = dark

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
shell-integration-features = cursor,title,sudo

# Ouverture instantanée des nouvelles fenêtres
gtk-single-instance = true

