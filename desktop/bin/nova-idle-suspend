#!/usr/bin/env bash
# nova-idle-suspend battery|always — mise en veille automatique.
# « battery » : seulement si l'ordinateur est sur batterie.
set -euo pipefail
mode="${1:-always}"
on_ac() {
  local supply
  for supply in /sys/class/power_supply/*; do
    [[ -r "$supply/type" ]] || continue
    case "$(<"$supply/type")" in
      Mains|USB) [[ "$(cat "$supply/online" 2>/dev/null)" == 1 ]] && return 0 ;;
    esac
  done
  return 1
}
if [[ "$mode" == battery ]] && on_ac; then
  exit 0
fi
exec systemctl suspend
