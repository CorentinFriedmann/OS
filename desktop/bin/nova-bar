#!/usr/bin/env bash
# Barre du haut (Waybar) avec la configuration de Nova. Waybar ignore
# XDG_CONFIG_DIRS : on lui donne donc les fichiers explicitement (une
# configuration personnelle dans ~/.config/waybar reste prioritaire).
# Ses messages vont dans le journal : journalctl --user -t nova-bar
# Si elle s'arrête sur une erreur, elle est relancée (5 fois au plus d'affilée).
config=$(nova-config waybar/config.jsonc) || exit 1
style=$(nova-config waybar/style.css) || exit 1
# Écran étroit (petit écran, grande mise à l'échelle, machine virtuelle) : barre
# compacte, sinon elle déborde à droite. Seulement avec la configuration de Nova.
narrowest_width() {
  timeout 3 hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
widths = [round((m["height"] if m.get("transform", 0) % 2 else m["width"]) / (m.get("scale") or 1))
          for m in json.load(sys.stdin)]
print(min(widths))' 2>/dev/null
}
if [[ "$config" == /usr/share/nova/xdg/waybar/config.jsonc && -z "${NOVA_BAR_FULL:-}" ]]; then
  width=$(narrowest_width)
  if [[ "$width" =~ ^[0-9]+$ ]] && (( width < 1500 )); then
    config=/usr/share/nova/xdg/waybar/config-compact.jsonc
  fi
fi
# Journal système si disponible ; sinon lancement direct (la barre passe avant les messages)
if systemd-cat -t nova-bar true 2>/dev/null; then
  journal() { systemd-cat -t nova-bar "$@"; }
else
  journal() { "$@"; }
fi
# La session graphique qui a lancé la barre est-elle toujours là ? (pas de relance
# après une déconnexion : la barre s'accrocherait à la session suivante)
session_alive() {
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    timeout 3 hyprctl version >/dev/null 2>&1
  else
    [[ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/${WAYLAND_DISPLAY:-wayland-0}" ]]
  fi
}
pkill -x waybar 2>/dev/null && sleep 0.5   # une seule barre à la fois
failures=0
while (( failures < 5 )); do
  started=$SECONDS
  journal waybar -c "$config" -s "$style" "$@"
  code=$?
  (( code == 0 )) && exit 0                     # arrêt normal
  session_alive || exit 0                       # fin de session : rien à relancer
  (( SECONDS - started > 60 )) && failures=0    # a tourné un moment : on repart de zéro
  failures=$((failures + 1))
  echo "Waybar s'est arrêté (code $code) : relance $failures/5" | journal cat
  sleep 2
done
echo "Waybar s'arrête sans cesse : abandon (voir journalctl --user -t nova-bar)" | journal cat
exit 1
